{
  "manifest_version": 3,
  "name": "AI Selection Explainer",
  "version": "1.0.0",
  "action": {
    "default_icon": {
      "16": "ai-explainer-chrome-icon.png",
      "48": "ai-explainer-chrome-icon.png",
      "128": "ai-explainer-chrome-icon.png"
    }
  },
  "icons": {
    "16": "ai-explainer-chrome-icon.png",
    "48": "ai-explainer-chrome-icon.png",
    "128": "ai-explainer-chrome-icon.png"
  },
  "description": "Explain selected text, image, and screenshot with your own OpenAI or Gemini API key.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "clipboardWrite",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "options_page": "options.html",
  "commands": {
    "activate-crop": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "MacCtrl+Shift+X"
      },
      "description": "Start screen crop selection with a keyboard shortcut"
    }
  }
}
